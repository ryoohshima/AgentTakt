{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ryoohshima/agenttakt",
  "title": "AgentTakt",
  "description": "Review, edit, and approve AI agent task plans in a ComfyUI-style visual node editor in your terminal",
  "version": "0.2.1",
  "repository": {
    "url": "https://github.com/ryoohshima/AgentTakt",
    "source": "github",
    "id": "1319748709"
  },
  "websiteUrl": "https://github.com/ryoohshima/AgentTakt",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/ryoohshima/AgentTakt/main/docs/images/icon.png",
      "sizes": ["212x212"],
      "mimeType": "image/png"
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agenttakt",
      "version": "0.2.1",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve",
          "valueHint": "serve"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
